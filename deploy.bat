@echo off
setlocal EnableExtensions
title Nineyin Deploy

rem ============================================================
rem  Nine Yin Go server deploy script.
rem
rem  Steps:
rem    [1] Load NINEYIN_SERVER_ROOT from env.server
rem        (an already-defined environment variable takes priority)
rem    [2] Copy build\* into the target root, overwriting existing files
rem    [3] Copy server-cmd\* into the target root only when missing,
rem        so local edits on the target side survive redeploys
rem    [4] Mirror the scripts\ tree (host + module\{combat,neigong,...})
rem        into the target, overwriting - Lua logic ships with the exe
rem        (2026-11-08: F: deploy was missing scripts\module\combat\
rem        formula.lua and the combat engine silently fell back)
rem    [5] Create env.server in the target root with default values
rem        when missing (existing file is never touched)
rem
rem  Usage: deploy.bat
rem    Run build.bat first; this script ships what is in build\ and scripts\.
rem ============================================================

cd /d "%~dp0"

rem ---------- [1/5] Load NINEYIN_SERVER_ROOT from env.server ----------
if defined NINEYIN_SERVER_ROOT goto root_loaded
if not exist "env.server" (
    echo [ERROR] NINEYIN_SERVER_ROOT is not defined and env.server was not found.
    echo         Copy env.server.default to env.server and fill in the target path.
    pause
    exit /b 1
)
rem Execute only the lines that start with "set " so comments (::) are skipped.
for /f "usebackq delims=" %%L in (`findstr /b /l /c:"set " "env.server"`) do call %%L
:root_loaded
if not defined NINEYIN_SERVER_ROOT (
    echo [ERROR] NINEYIN_SERVER_ROOT is not set in env.server.
    pause
    exit /b 1
)
if not exist "%NINEYIN_SERVER_ROOT%" (
    echo [ERROR] Target folder does not exist: %NINEYIN_SERVER_ROOT%
    echo         Check NINEYIN_SERVER_ROOT in env.server.
    pause
    exit /b 1
)

echo ==========================================
echo   Nine Yin Go server deploy
echo ==========================================
echo   Target : %NINEYIN_SERVER_ROOT%
echo ==========================================
echo.

rem ---------- [2/5] build\* -> target, overwrite ----------
echo [2/5] Deploying build\* (overwrite)...
if not exist "build\*" (
    echo [ERROR] build\ is empty. Run build.bat first.
    pause
    exit /b 1
)
set /a BUILD_N=0
for %%f in ("%~dp0build\*") do (
    call :deploy_build_file "%%~ff" "%%~nxf"
    if errorlevel 1 goto deploy_fail
    set /a BUILD_N+=1
)

rem ---------- [3/5] server-cmd\* -> target, only if missing ----------
echo [3/5] Deploying server-cmd\* (skip existing)...
set /a CMD_NEW=0
set /a CMD_SKIP=0
for %%f in ("%~dp0server-cmd\*") do (
    call :deploy_cmd_file "%%~ff" "%%~nxf"
    if errorlevel 1 goto deploy_fail
)

rem ---------- [4/5] scripts\ tree -> target, overwrite ----------
echo [4/5] Deploying scripts\ tree (overwrite)...
set /a SCRIPT_N=0
if exist "%~dp0scripts" (
    for /f "delims=" %%f in ('dir /s /b /a:-d "%~dp0scripts" 2^>nul') do set /a SCRIPT_N+=1
    rem /h: hidden/system files must ship too, /e: all subdirs, /y: overwrite, /i: dest is a dir
    xcopy /e /h /y /i "%~dp0scripts\*" "%NINEYIN_SERVER_ROOT%\scripts\" >nul
    if errorlevel 2 (
        echo [ERROR] Failed to mirror scripts\ into the target.
        goto deploy_fail
    )
    echo   [scripts] tree mirrored ^(existing overwritten^)
) else (
    echo   [scripts] repo has no scripts\ tree - skipped
)

rem ---------- [5/5] env.server -> create with defaults if missing ----------
echo [5/5] Checking env.server...
if exist "%NINEYIN_SERVER_ROOT%\env.server" (
    echo   [env.server] exists, left untouched
    goto env_server_done
)
>"%NINEYIN_SERVER_ROOT%\env.server" echo :: Local config generated by deploy.bat - edit freely, deploys never overwrite.
>>"%NINEYIN_SERVER_ROOT%\env.server" echo set "NINEYIN_SERVER_ROOT=%NINEYIN_SERVER_ROOT%"
>>"%NINEYIN_SERVER_ROOT%\env.server" echo set "NINEYIN_MYSQL_DSN=nineyin:nineyin123@tcp(127.0.0.1:3306)/nineyin"
echo   [env.server] created with defaults ^(loaded by start-9yin.bat^)
:env_server_done

echo.
echo ==========================================
echo Deploy finished.
echo   build     : %BUILD_N% file(s) copied (existing overwritten)
echo   server-cmd: %CMD_NEW% added, %CMD_SKIP% skipped (already present)
echo   scripts   : %SCRIPT_N% file(s) mirrored (existing overwritten)
echo   Target    : %NINEYIN_SERVER_ROOT%
echo   Start with: %NINEYIN_SERVER_ROOT%\start-9yin.bat
echo ==========================================

endlocal
exit /b 0

:deploy_fail
echo.
echo [ERROR] Deploy aborted.
pause
exit /b 1

rem ================= helpers =================

rem Copy one build artifact into the target root, overwriting.
:deploy_build_file
if not exist "%~1" exit /b 0
if exist "%NINEYIN_SERVER_ROOT%\%~2" (set "TAG=overwrite") else set "TAG=new"
copy /y "%~1" "%NINEYIN_SERVER_ROOT%\" >nul
if errorlevel 1 (
    echo [ERROR] Failed to copy %~2. If the server exe is running, close it first.
    exit /b 1
)
echo   [build] %~2 (%TAG%)
exit /b 0

rem Copy one launcher script into the target root only when missing.
:deploy_cmd_file
if not exist "%~1" exit /b 0
if exist "%NINEYIN_SERVER_ROOT%\%~2" (
    echo   [server-cmd] %~2 - exists, skipped
    set /a CMD_SKIP+=1
    exit /b 0
)
copy /y "%~1" "%NINEYIN_SERVER_ROOT%\" >nul
if errorlevel 1 (
    echo [ERROR] Failed to copy %~2.
    exit /b 1
)
echo   [server-cmd] %~2 - copied
set /a CMD_NEW+=1
exit /b 0
